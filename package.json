{
  "name": "git-graph-next",
  "displayName": "Git Graph Next",
  "description": "View a fast, interactive Git graph of your repository, and perform Git actions from the graph.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "git-graph-next",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "log",
    "history",
    "branch"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:gitGraphNext.view"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Graph Next executes the git binary against the workspace, which is unsafe in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitGraphNext.view",
        "title": "View Git Graph",
        "category": "Git Graph Next",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphNext.viewForRepo",
        "title": "View Git Graph for Repository",
        "category": "Git Graph Next",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphNext.viewFileHistory",
        "title": "View File History in Git Graph",
        "category": "Git Graph Next",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphNext.refresh",
        "title": "Refresh Git Graph",
        "category": "Git Graph Next",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphNext.addGitRepository",
        "title": "Add Git Repository...",
        "category": "Git Graph Next"
      },
      {
        "command": "gitGraphNext.removeGitRepository",
        "title": "Remove Git Repository...",
        "category": "Git Graph Next"
      },
      {
        "command": "gitGraphNext.openChangeDiff",
        "title": "Open Changes",
        "category": "Git Graph Next",
        "icon": "$(diff)"
      },
      {
        "command": "gitGraphNext.openChangeFile",
        "title": "Open File",
        "category": "Git Graph Next",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitGraphNext.copyChangePath",
        "title": "Copy Relative Path",
        "category": "Git Graph Next"
      },
      {
        "command": "gitGraphNext.openFullGraph",
        "title": "Open Git Graph in Editor",
        "category": "Git Graph Next",
        "icon": "$(link-external)"
      },
      {
        "command": "gitGraphNext.toggleCompact",
        "title": "Toggle Compact Graph",
        "category": "Git Graph Next",
        "icon": "$(fold)"
      },
      {
        "command": "gitGraphNext.fetch",
        "title": "Fetch",
        "category": "Git Graph Next",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraphNext.review.next",
        "title": "Code Review: Next File",
        "category": "Git Graph Next",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphNext.review.previous",
        "title": "Code Review: Previous File",
        "category": "Git Graph Next",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitGraphNext.review.openAll",
        "title": "Code Review: Open All Files in One Editor",
        "category": "Git Graph Next",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitGraphNext.review.end",
        "title": "Code Review: End Review",
        "category": "Git Graph Next",
        "icon": "$(check-all)"
      },
      {
        "command": "gitGraphNext.resumeWorkspaceCodeReview",
        "title": "Resume a Code Review…",
        "category": "Git Graph Next"
      },
      {
        "command": "gitGraphNext.endAllWorkspaceCodeReviews",
        "title": "End All Code Reviews in This Workspace",
        "category": "Git Graph Next"
      },
      {
        "command": "gitGraphNext.clearAvatarCache",
        "title": "Clear Avatar Cache",
        "category": "Git Graph Next"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitGraphNext.viewForRepo",
          "when": "false"
        },
        {
          "command": "gitGraphNext.openChangeDiff",
          "when": "false"
        },
        {
          "command": "gitGraphNext.openChangeFile",
          "when": "false"
        },
        {
          "command": "gitGraphNext.copyChangePath",
          "when": "false"
        },
        {
          "command": "gitGraphNext.openFullGraph",
          "when": "false"
        },
        {
          "command": "gitGraphNext.toggleCompact",
          "when": "false"
        },
        {
          "command": "gitGraphNext.fetch",
          "when": "false"
        },
        {
          "command": "gitGraphNext.review.next",
          "when": "gitGraphNext.reviewActive"
        },
        {
          "command": "gitGraphNext.review.previous",
          "when": "gitGraphNext.reviewActive"
        },
        {
          "command": "gitGraphNext.review.openAll",
          "when": "gitGraphNext.reviewActive"
        },
        {
          "command": "gitGraphNext.review.end",
          "when": "gitGraphNext.reviewActive"
        }
      ],
      "scm/title": [
        {
          "command": "gitGraphNext.view",
          "group": "navigation",
          "when": "config.git-graph-next.showScmTitleIcon && gitGraphNext.enabled"
        }
      ],
      "explorer/context": [
        {
          "command": "gitGraphNext.viewForRepo",
          "group": "gitGraphNext@1",
          "when": "gitGraphNext.enabled && explorerResourceIsFolder"
        },
        {
          "command": "gitGraphNext.viewFileHistory",
          "group": "gitGraphNext@2",
          "when": "gitGraphNext.enabled && resourceScheme == file"
        }
      ],
      "view/title": [
        {
          "command": "gitGraphNext.fetch",
          "when": "view == gitGraphNext.graphView",
          "group": "navigation@0"
        },
        {
          "command": "gitGraphNext.toggleCompact",
          "when": "view == gitGraphNext.graphView",
          "group": "navigation@0"
        },
        {
          "command": "gitGraphNext.refresh",
          "when": "view == gitGraphNext.graphView",
          "group": "navigation@1"
        },
        {
          "command": "gitGraphNext.openFullGraph",
          "when": "view == gitGraphNext.graphView",
          "group": "navigation@2"
        },
        {
          "command": "gitGraphNext.review.previous",
          "when": "view == gitGraphNext.changesView && gitGraphNext.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "gitGraphNext.review.next",
          "when": "view == gitGraphNext.changesView && gitGraphNext.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "gitGraphNext.review.openAll",
          "when": "view == gitGraphNext.changesView && gitGraphNext.reviewActive",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphNext.review.end",
          "when": "view == gitGraphNext.changesView && gitGraphNext.reviewActive",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "gitGraphNext.openChangeFile",
          "when": "view == gitGraphNext.changesView && viewItem == change",
          "group": "inline"
        },
        {
          "command": "gitGraphNext.openChangeDiff",
          "when": "view == gitGraphNext.changesView",
          "group": "1_open@1"
        },
        {
          "command": "gitGraphNext.openChangeFile",
          "when": "view == gitGraphNext.changesView && viewItem == change",
          "group": "1_open@2"
        },
        {
          "command": "gitGraphNext.copyChangePath",
          "when": "view == gitGraphNext.changesView",
          "group": "2_copy@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitGraphNext.viewFileHistory",
          "group": "navigation@100",
          "when": "config.git-graph-next.showEditorTitleIcon && gitGraphNext.enabled && resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitGraphNext.viewFileHistory",
          "group": "gitGraphNext@1",
          "when": "gitGraphNext.enabled && resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "gitGraphNext.viewFileHistory",
          "group": "gitGraphNext@1",
          "when": "gitGraphNext.enabled && resourceScheme == file"
        }
      ]
    },
    "configuration": {
      "title": "Git Graph Next",
      "properties": {
        "git-graph-next.showScmTitleIcon": {
          "type": "boolean",
          "default": true,
          "description": "Show a Git Graph icon in the title bar of the Source Control view.",
          "scope": "window"
        },
        "git-graph-next.showEditorTitleIcon": {
          "type": "boolean",
          "default": false,
          "description": "Show a Git Graph icon in the editor title bar, to open the file's history.",
          "scope": "window"
        },
        "git-graph-next.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a 'Git Graph' item in the Status Bar.",
          "scope": "window"
        },
        "git-graph-next.git.path": {
          "type": [
            "string",
            "array",
            "null"
          ],
          "default": null,
          "description": "Path(s) to the git executable. When null, the path configured in 'git.path' is used, falling back to 'git' on PATH.",
          "scope": "machine"
        },
        "git-graph-next.maxCommits": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "The number of commits to initially load.",
          "scope": "window"
        },
        "git-graph-next.loadMoreCommits": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "The number of additional commits to load when 'Load More Commits' is used.",
          "scope": "window"
        },
        "git-graph-next.loadMoreCommitsAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Automatically load more commits when scrolling to the bottom of the graph.",
          "scope": "window"
        },
        "git-graph-next.graph.style": {
          "type": "string",
          "enum": [
            "rounded",
            "angular"
          ],
          "default": "rounded",
          "description": "The style of the graph edges.",
          "scope": "window"
        },
        "git-graph-next.graph.colours": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#0085d9",
            "#d9008f",
            "#00d90a",
            "#d98500",
            "#a300d9",
            "#ff0000",
            "#00d9cc",
            "#e138e8",
            "#85d900",
            "#dc5b23",
            "#6f24d6",
            "#ffcc00"
          ],
          "description": "The colours used on the graph.",
          "scope": "window"
        },
        "git-graph-next.graph.pinnedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Branches drawn as a straight line in a column of their own, leftmost first (e.g. `[\"main\", \"develop\"]`). Names may use `*` as a wildcard (`release/*`); remote branches are named with their remote (`origin/main`). Branches can also be pinned per repository from a branch label's context menu.",
          "scope": "resource"
        },
        "git-graph-next.graph.branchColours": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Fixed colours for branches, e.g. `{ \"main\": \"#e5484d\", \"release/*\": \"#f5a524\" }`. The branch and its first-parent history keep that colour. Names may use `*`; remote branches are named with their remote (`origin/main`).",
          "scope": "resource"
        },
        "git-graph-next.graph.colourCommitRows": {
          "type": "boolean",
          "default": false,
          "description": "Show each commit's branch colour as a stripe at the start of its row, next to the message.",
          "scope": "window"
        },
        "git-graph-next.graph.stickyHeader": {
          "type": "boolean",
          "default": true,
          "description": "Keep the column header row visible while scrolling the graph.",
          "scope": "window"
        },
        "git-graph-next.date.type": {
          "type": "string",
          "enum": [
            "Author Date",
            "Commit Date"
          ],
          "default": "Author Date",
          "description": "The date type displayed and used for ordering.",
          "scope": "window"
        },
        "git-graph-next.date.format": {
          "type": "string",
          "enum": [
            "Date & Time",
            "Date Only",
            "ISO Date & Time",
            "ISO Date Only",
            "Relative"
          ],
          "default": "Date & Time",
          "description": "The format of dates shown in the graph.",
          "scope": "window"
        },
        "git-graph-next.commitOrdering": {
          "type": "string",
          "enum": [
            "date",
            "author-date",
            "topological"
          ],
          "default": "date",
          "description": "The ordering of commits (passed to git log).",
          "scope": "window"
        },
        "git-graph-next.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show remote branches by default.",
          "scope": "window"
        },
        "git-graph-next.includeCommitsMentionedByReflogs": {
          "type": "boolean",
          "default": false,
          "description": "Include commits only mentioned by reflogs when showing all branches.",
          "scope": "window"
        },
        "git-graph-next.onlyFollowFirstParent": {
          "type": "boolean",
          "default": false,
          "description": "Only follow the first parent of commits.",
          "scope": "window"
        },
        "git-graph-next.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show tags in the graph by default.",
          "scope": "window"
        },
        "git-graph-next.excludeBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns of branches and tags to hide from the graph, passed to `git log --exclude`. A pattern matches the name without its `refs/…/` prefix: `feature/*` hides local feature branches, `origin/dependabot/*` hides remote ones, `nightly-*` hides tags. `*` also matches `/`. The checked-out branch is always shown. More patterns can be added per repository in the Branches dropdown.",
          "scope": "resource"
        },
        "git-graph-next.extraLogArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `git log`, one per item, e.g. `[\"--no-merges\"]` or `[\"--since=1 year ago\"]`. Arguments that would break the graph (output format, diff output, `--reverse`, commit counts, `--output`, …) are rejected with an explanation. More can be added per repository in the Filter bar.",
          "scope": "resource"
        },
        "git-graph-next.showUncommittedChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show the Uncommitted Changes row.",
          "scope": "window"
        },
        "git-graph-next.showUntrackedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Include untracked files in the Uncommitted Changes row.",
          "scope": "window"
        },
        "git-graph-next.showNotes": {
          "type": "boolean",
          "default": true,
          "description": "Mark commits that have git notes, and show the note in the commit details.",
          "scope": "resource"
        },
        "git-graph-next.fetchAvatars": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show author avatars. **This contacts other services:** for each author shown, the MD5 hash of their e-mail address is sent to Gravatar, or their user name to GitHub for GitHub no-reply addresses. Avatars are cached; clear them with **Git Graph Next: Clear Avatar Cache**.",
          "scope": "window"
        },
        "git-graph-next.issueLinking.autoDetect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Link issue and merge request references for repositories hosted on GitHub (`#123`) and GitLab (`#123`, `!45`), detected from the `origin` remote.",
          "scope": "resource"
        },
        "git-graph-next.issueLinking.rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "url"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "A JavaScript regular expression matched in commit messages, e.g. \"([A-Z]+-\\\\d+)\"."
              },
              "url": {
                "type": "string",
                "description": "The link. $0 is the whole match, $1…$9 its groups; ${host}, ${owner}, ${repo} and ${repoUrl} come from the origin remote."
              }
            }
          },
          "markdownDescription": "Links for references in commit messages, e.g. `[{ \"pattern\": \"([A-Z]+-\\\\d+)\", \"url\": \"https://jira.example.com/browse/$1\" }]`. `$1`…`$9` are the match's groups; `${host}`, `${owner}`, `${repo}` and `${repoUrl}` are filled from the `origin` remote, so one rule can serve every repository.",
          "scope": "resource"
        },
        "git-graph-next.referenceLabels.alignment": {
          "type": "string",
          "enum": [
            "Normal",
            "Branches (on the left) & Tags (on the right)"
          ],
          "default": "Normal",
          "description": "Where branch and tag labels are drawn in the Description column: all before the message, or tags at the right-hand end.",
          "scope": "window"
        },
        "git-graph-next.referenceLabels.combineLocalAndRemoteBranchLabels": {
          "type": "boolean",
          "default": true,
          "description": "Combine local and remote branch labels when they refer to the same branch.",
          "scope": "window"
        },
        "git-graph-next.repository.showRemoteHeads": {
          "type": "boolean",
          "default": true,
          "description": "Show remote HEAD symbolic references.",
          "scope": "window"
        },
        "git-graph-next.repository.fetchAndPrune": {
          "type": "boolean",
          "default": false,
          "description": "Prune remote-tracking references when fetching.",
          "scope": "window"
        },
        "git-graph-next.repository.fetchAndPruneTags": {
          "type": "boolean",
          "default": false,
          "description": "Prune local tags that no longer exist on the remote when fetching.",
          "scope": "window"
        },
        "git-graph-next.repository.sign.commits": {
          "type": "boolean",
          "default": false,
          "description": "Enable commit signing (-S) for commits created from the graph.",
          "scope": "window"
        },
        "git-graph-next.repository.sign.tags": {
          "type": "boolean",
          "default": false,
          "description": "Enable tag signing (-s) for annotated tags created from the graph.",
          "scope": "window"
        },
        "git-graph-next.maxDepthOfRepoSearch": {
          "type": "number",
          "default": 0,
          "description": "The maximum depth of subfolders to search for repositories in the workspace.",
          "scope": "window"
        },
        "git-graph-next.openToTheRepoOfTheActiveTextEditorDocument": {
          "type": "boolean",
          "default": false,
          "description": "Open the Git Graph View to the repository containing the active editor's document.",
          "scope": "window"
        },
        "git-graph-next.retainContextWhenHidden": {
          "type": "boolean",
          "default": true,
          "description": "Keep the Git Graph View running in the background when it is not visible. Uses more memory, but restores instantly.",
          "scope": "window"
        },
        "git-graph-next.integratedTerminalShell": {
          "type": "string",
          "default": "",
          "description": "Shell executable used when the graph opens an Integrated Terminal (e.g. for interactive rebase).",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitGraphNext",
          "title": "Git Graph Next",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gitGraphNext": [
        {
          "type": "webview",
          "id": "gitGraphNext.graphView",
          "name": "Graph",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Git Graph Next"
        },
        {
          "id": "gitGraphNext.changesView",
          "name": "Changes",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Git Graph Next"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitGraphNext.review.next",
        "key": "alt+]",
        "when": "gitGraphNext.reviewActive"
      },
      {
        "command": "gitGraphNext.review.previous",
        "key": "alt+[",
        "when": "gitGraphNext.reviewActive"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"out/test/*.test.js\"",
    "vsce:package": "npm run package && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/git-graph-next/git-graph-next.git"
  },
  "pricing": "Free"
}
